{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Harness Core (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows/x64/debug/harness-core.exe",
