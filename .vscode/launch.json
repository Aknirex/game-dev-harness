    {
      "name": "Debug Harness Tests (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows/x64/debug/harness-tests.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "xmake: build debug",
      "terminal": "integrated",
      "sourceLanguages": ["cpp"]
    }
  ]
}
